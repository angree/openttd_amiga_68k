+		 * window taller than a small Amiga screen can be pulled up until
+		 * its off-screen confirm/OK buttons become reachable. The drag
+		 * begins on the mouse PRESS, exactly like WWT_CAPTION: this handler
+		 * runs on the press edge (MC_LEFT), StartWindowDrag() sets
+		 * WF_DRAGGING, and HandleWindowDragging() then moves the window on
+		 * the following mouse motion.
+		 *
+		 * WWT_LABEL/WWT_TEXT/WWT_EMPTY/NWID_SPACER have no inherent click
+		 * action, so they start a drag even when they carry a widget index.
+		 * This is required for the Difficulty window, whose setting labels
+		 * are indexed WWT_TEXT that fill each row (SetFill) yet are never
+		 * handled by OnClick - with an index gate the body never dragged.
+		 * WWT_PANEL/WWT_FRAME can be genuine click targets (e.g. the
+		 * Advanced Settings options panel dispatches clicks via OnClick),
+		 * so they only start a drag when they have no index, i.e. the
+		 * window is not interested in them. Interactive widgets - buttons,
+		 * dropdowns, scrollbars, matrices, editboxes, resize/close/shade/
+		 * sticky - are handled by their own cases above and never reach
+		 * here, so real clicks are never converted into drags.
+		 *
+		 * A window can only be dragged if it actually owns a caption:
+		 * HandleWindowDragging() asserts the caption exists and reads its
+		 * rectangle, so starting a body-drag on a caption-less window
+		 * (tooltips, toolbars) would crash. Guard on that. */
+		case WWT_LABEL:
+		case WWT_TEXT:
+		case WWT_EMPTY:
+		case NWID_SPACER:
+			if (w->nested_root->GetWidgetOfType(WWT_CAPTION) != NULL) {
+				StartWindowDrag(w);
+				return;
+			}
+			break;
+
+		case WWT_PANEL:
+		case WWT_FRAME:
+			if (widget_index < 0 && w->nested_root->GetWidgetOfType(WWT_CAPTION) != NULL) {
+				StartWindowDrag(w);
+				return;
+			}
+			break;
+
 		default:
 			break;
 	}
