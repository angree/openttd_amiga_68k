+/**
+ * @file tcp_coordinator.h Wire definitions for the OpenTTD Game Coordinator.
+ *
+ * The coordinator replaced the UDP master server in OpenTTD 12.0. It is a plain,
+ * unencrypted, uncompressed TCP protocol on coordinator.openttd.org:3976 using the
+ * same framing as the game protocol: uint16 length (little endian, counting itself
+ * and the type byte), uint8 type, payload. Strings are NUL terminated and carry no
+ * length prefix. Every multi-byte integer on the wire is LITTLE ENDIAN, so on 68k
+ * every field has to be byte swapped - the writers/readers in network_coordinator.cpp
+ * do that explicitly rather than memcpy-ing structs.
+ *
+ * We deliberately announce protocol version 2, which buys three simplifications:
+ *  - the coordinator probes our game port directly instead of demanding STUN, so a
+ *    port-forwarded server reaches CONNECTION_TYPE_DIRECT with no NAT traversal code;
+ *  - GC_NEWGRF_LOOKUP (only sent from version 4 up) never arrives, so we never have
+ *    to buffer its ~32 KB payload;
+ *  - version 2 is the floor for CLIENT_CONNECT, which we need in order to join by
+ *    invite code.
+ * Version 2 is also the highest version that still takes the "probe directly" path,
+ * so do not raise it without implementing STUN.
+ */
+
+#ifndef NETWORK_CORE_TCP_COORDINATOR_H
+#define NETWORK_CORE_TCP_COORDINATOR_H
+
+#ifdef ENABLE_NETWORK
+
+/** Packet types of the game coordinator protocol; the value IS the wire byte. */
+enum PacketCoordinatorType {
+	PACKET_COORDINATOR_GC_ERROR,            ///< coordinator -> both: something went wrong
+	PACKET_COORDINATOR_SERVER_REGISTER,     ///< server -> coordinator: register me
+	PACKET_COORDINATOR_GC_REGISTER_ACK,     ///< coordinator -> server: you are registered
+	PACKET_COORDINATOR_SERVER_UPDATE,       ///< server -> coordinator: my current game info
+	PACKET_COORDINATOR_CLIENT_LISTING,      ///< client -> coordinator: send me the server list
+	PACKET_COORDINATOR_GC_LISTING,          ///< coordinator -> client: one server (count 0 ends)
+	PACKET_COORDINATOR_CLIENT_CONNECT,      ///< client -> coordinator: connect me to this invite code
+	PACKET_COORDINATOR_GC_CONNECTING,       ///< coordinator -> client: here is your token
+	PACKET_COORDINATOR_SERCLI_CONNECT_FAILED, ///< both -> coordinator: that attempt failed
+	PACKET_COORDINATOR_GC_CONNECT_FAILED,   ///< coordinator -> both: giving up on this token
+	PACKET_COORDINATOR_CLIENT_CONNECTED,    ///< client -> coordinator: I am in
+	PACKET_COORDINATOR_GC_DIRECT_CONNECT,   ///< coordinator -> client: connect to this host:port
+	PACKET_COORDINATOR_GC_STUN_REQUEST,     ///< coordinator -> both: begin STUN (we ignore it)
+	PACKET_COORDINATOR_SERCLI_STUN_RESULT,  ///< both -> coordinator: STUN outcome (never sent)
+	PACKET_COORDINATOR_GC_STUN_CONNECT,     ///< coordinator -> both: reuse the STUN local address
+	PACKET_COORDINATOR_GC_NEWGRF_LOOKUP,    ///< coordinator -> client: NewGRF table (version >= 4)
+	PACKET_COORDINATOR_GC_TURN_CONNECT,     ///< coordinator -> both: relay fallback (we ignore it)
+	PACKET_COORDINATOR_END                  ///< must stay last
+};
+
+/** How a registered server can be reached; returned in GC_REGISTER_ACK. */
+enum CoordinatorConnectionType {
+	CONNECTION_TYPE_UNKNOWN  = 0, ///< never sent by the coordinator
+	CONNECTION_TYPE_ISOLATED = 1, ///< unreachable - we are NOT listed
+	CONNECTION_TYPE_DIRECT   = 2, ///< the coordinator reached our game port; the goal
+	CONNECTION_TYPE_STUN     = 3, ///< reachable only by hole punching
+	CONNECTION_TYPE_TURN     = 4  ///< relayed only
+};
+
+/** Whether and how a server wants to be listed; sent in SERVER_REGISTER. */
+enum ServerGameType {
+	SERVER_GAME_TYPE_LOCAL       = 0, ///< do not talk to the coordinator at all
+	SERVER_GAME_TYPE_PUBLIC      = 1, ///< show up in the public server list
+	SERVER_GAME_TYPE_INVITE_ONLY = 2  ///< registered, but filtered out of the listing
+};
+
+/** Error codes carried by GC_ERROR. */
+enum NetworkCoordinatorErrorType {
+	NETWORK_COORDINATOR_ERROR_UNKNOWN             = 0,
+	NETWORK_COORDINATOR_ERROR_REGISTRATION_FAILED = 1,
+	NETWORK_COORDINATOR_ERROR_INVALID_INVITE_CODE = 2,
+	NETWORK_COORDINATOR_ERROR_REUSE_OF_INVITE_CODE = 3
+};
+
+#endif /* ENABLE_NETWORK */
+
+#endif /* NETWORK_CORE_TCP_COORDINATOR_H */
