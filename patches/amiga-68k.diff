+#if defined(__AMIGA__)
+/* newlib syscall stubs not provided by libnix on AmigaOS */
+#include <sys/time.h>
+#include <errno.h>
+#include <proto/dos.h>
+extern "C" int _gettimeofday(struct timeval *tv, void *tz)
+{
+	(void)tz;
+	if (tv != 0) {
+		struct DateStamp ds;
+		DateStamp(&ds);
+		tv->tv_sec  = (long)ds.ds_Days * 86400L + (long)ds.ds_Minute * 60L + (long)ds.ds_Tick / 50L;
+		tv->tv_usec = ((long)ds.ds_Tick % 50L) * 20000L;
+	}
+	return 0;
+}
+extern "C" int _link(const char *a, const char *b)
+{
+	(void)a; (void)b; errno = ENOSYS; return -1;
+}
+#endif /* __AMIGA__ */
