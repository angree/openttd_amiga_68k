+#include <cxxabi.h>
+static void NORETURN AmigaTerminateHandler()
+{
+	fprintf(stdout, "FATAL: std::terminate() called - uncaught C++ exception or broken unwind\n");
+	/* Identify what was thrown: bad_alloc (out of memory) looks very different
+	 * from SlError's std::exception, and both are plausible here. */
+	std::type_info *t = abi::__cxa_current_exception_type();
+	if (t != NULL) {
+		int status = 0;
+		char *dem = abi::__cxa_demangle(t->name(), NULL, NULL, &status);
+		fprintf(stdout, "FATAL: in-flight exception type = '%s'\n", (status == 0 && dem != NULL) ? dem : t->name());
+	} else {
+		fprintf(stdout, "FATAL: no in-flight exception -> terminate from failed unwind / pure virtual call\n");
+	}
+	fflush(stdout);
