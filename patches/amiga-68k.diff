+/** Signature of a container version 2 GRF: the eight bytes after a leading 0x0000. */
+static const byte _grf_cont_v2_sig[8] = {'G', 'R', 'F', 0x82, 0x0D, 0x0A, 0x1A, 0x0A};
+
+/**
+ * Get the container version of the currently opened GRF file.
+ *
+ * Container 1 has no header at all, which is why the probe has to be written
+ * this way round: a leading 16-bit zero is impossible in container 1 (it would
+ * be a zero-length sprite, i.e. end of file), so it is used as the marker for
+ * container 2 and followed by a signature. Anything else means container 1 and
+ * the file position is rewound so not a byte is consumed.
+ *
+ * @return 1 or 2, or 0 if the file is not a GRF at all.
+ */
+byte GetGRFContainerVersion()
+{
+	size_t pos = FioGetPos();
+
+	if (FioReadWord() == 0) {
+		for (uint i = 0; i < lengthof(_grf_cont_v2_sig); i++) {
+			if (FioReadByte() != _grf_cont_v2_sig[i]) return 0; // Invalid format
+		}
+		return 2;
+	}
+
+	/* Container version 1 has no header, rewind to start. */
+	FioSeekTo(pos, SEEK_SET);
+	return 1;
+}
