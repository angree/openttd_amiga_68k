+/** Classic container: the sprite header sits inline, right where we are. */
+static bool LoadSpriteV1(SpriteLoader::Sprite *sprite, uint8 file_slot, size_t file_pos, SpriteType sprite_type)
+{
+	/* Open the right file and go to the correct position */
+	FioSeekToFile(file_slot, file_pos);
+
+	/* Read the size and type */
+	int num = FioReadWord();
+	byte type = FioReadByte();
+
+	/* Type 0xFF indicates either a colourmap or some other non-sprite info; we do not handle them here */
+	if (type == 0xFF) return false;
+
+	sprite->height = FioReadByte();
+	sprite->width  = FioReadWord();
+	sprite->x_offs = FioReadWord();
+	sprite->y_offs = FioReadWord();
+
+	/* 0x02 indicates it is a compressed sprite, so we can't rely on 'num' to be valid.
+	 *  In case it is uncompressed, the size is 'num' - 8 (header-size). */
+	num = (type & 0x02) ? sprite->width * sprite->height : num - 8;
+
+	return DecodeSingleSprite(sprite, file_slot, file_pos, sprite_type, num, type, 1);
+}
+
+/**
+ * Container version 2: the sprite lives in a separate sprite section, and the
+ * same id can carry SEVERAL encodings one after another - different colour
+ * depths and zoom levels. This port wants exactly one of them, 8bpp at zoom 0;
+ * that is the only reason this is a loop.
+ */
+static bool LoadSpriteV2(SpriteLoader::Sprite *sprite, uint8 file_slot, size_t file_pos, SpriteType sprite_type)
+{
+	/* The sprite is not present in the sprite section at all. */
+	if (file_pos == SIZE_MAX) return false;
+
+	FioSeekToFile(file_slot, file_pos);
+
+	uint32 id = FioReadDword();
+
+	do {
+		int num = (int)FioReadDword();
+		size_t start_pos = FioGetPos();
+		byte type = FioReadByte();
+
+		/* Type 0xFF is a colourmap or other non-sprite info; not ours to decode. */
+		if (type == 0xFF) return false;
+
+		byte colour = type & 0x07;   /* bit 0 RGB, bit 1 alpha, bit 2 palette */
+		byte zoom   = FioReadByte();
+
+		/* Palette-only (8bpp) at zoom 0 is the single encoding this port can
+		 * use. A 32bpp or zoomed variant is skipped and the loop tries the next
+		 * encoding of the same id; a set that ships only 32bpp sprites ends up
+		 * with none, which is correct and is what the caller reports. */
+		if (colour == 0x04 && (sprite_type != ST_NORMAL || zoom == 0)) {
+			sprite->height = FioReadWord();
+			sprite->width  = FioReadWord();
+			sprite->x_offs = FioReadWord();
+			sprite->y_offs = FioReadWord();
+
+			/* Mask the colour bits out; what remains are the encoding flags. */
+			type &= ~0x07;
+
+			/* Chunked sprites store their decompressed size; plain ones do not. */
+			int decomp_size = (type & 0x08) ? (int)FioReadDword() : sprite->width * sprite->height;
+
+			bool valid = DecodeSingleSprite(sprite, file_slot, file_pos, sprite_type, decomp_size, type, 2);
+			if (FioGetPos() != start_pos + num) return WarnCorruptSprite(file_slot, file_pos, __LINE__);
+			return valid;
+		}
+
+		/* Not the encoding we want - step over it. Two header bytes (type and
+		 * zoom) have already been consumed. */
+		FioSkipBytes(num - 2);
+	} while (FioReadDword() == id);
+
+	return false;
+}
+
+bool SpriteLoaderGrf::LoadSprite(SpriteLoader::Sprite *sprite, uint8 file_slot, size_t file_pos, SpriteType sprite_type)
+{
+	if (this->container_ver >= 2) {
+		return LoadSpriteV2(sprite, file_slot, file_pos, sprite_type);
+	}
+	return LoadSpriteV1(sprite, file_slot, file_pos, sprite_type);
+}
