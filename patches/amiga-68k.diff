+bool SQVM::CreateClassInstance(SQClass *theclass, SQObjectPtr &inst, SQObjectPtr &constructor)
+{
+	inst = theclass->CreateInstance();
+	if(!theclass->Get(_ss(this)->_constructoridx,constructor)) {
+		constructor = _null_;
+	}
+	return true;
+}
