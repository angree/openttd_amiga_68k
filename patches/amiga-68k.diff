+/** Big enough for the largest packet the coordinator can emit (its own cap is 32767). */
+static const uint COORD_RECV_BUF = 32768;
+/** Our outgoing packets are small; a SERVER_UPDATE with many NewGRFs is the largest. */
+static const uint COORD_SEND_BUF = 8192;
+
+/** How often we refresh our registration, in milliseconds (matches upstream). */
+static const uint32 COORD_UPDATE_INTERVAL = 30000;
+/** Reconnect backoff bounds, in milliseconds. */
+static const uint32 COORD_RECONNECT_MIN = 2000;
+static const uint32 COORD_RECONNECT_MAX = 32000;
+
+/** What this connection is being used for. */
+enum CoordinatorRole {
+	COORD_ROLE_NONE,   ///< idle
+	COORD_ROLE_SERVER, ///< we are registering ourselves
+	COORD_ROLE_CLIENT  ///< we are listing servers / resolving an invite code
+};
+
+static SOCKET _coord_sock = INVALID_SOCKET;
+static bool   _coord_connecting = false;
+static CoordinatorRole _coord_role = COORD_ROLE_NONE;
+
+static byte  *_coord_rbuf = NULL; ///< receive accumulator
+static uint   _coord_rlen = 0;
+static byte  *_coord_sbuf = NULL; ///< pending outgoing bytes
+static uint   _coord_slen = 0;
+static uint   _coord_spos = 0;
+
+static bool   _coord_registered = false;
+static bool   _coord_register_sent = false;
+static byte   _coord_conn_type = CONNECTION_TYPE_UNKNOWN;
+static uint32 _coord_next_update = 0;
+static uint32 _coord_retry_delay = COORD_RECONNECT_MIN;
+static uint32 _coord_retry_at = 0;
+
+static bool   _coord_listing = false;         ///< a listing request is in flight
+static uint   _coord_listed_count = 0;        ///< servers accepted in the current listing
+static bool   _coord_listing_wanted = false;  ///< user asked for a listing, not sent yet
+static char   _coord_join_invite[NETWORK_INVITE_CODE_LENGTH]; ///< invite code being joined, "" if none
+
+/** Invite code and secret we were assigned, so a restart can reclaim the same code. */
+static char _coord_invite_code[NETWORK_INVITE_CODE_LENGTH];
+static char _coord_invite_secret[NETWORK_INVITE_CODE_SECRET_LENGTH];
+
+/* ------------------------------------------------------------------ writing */
+
+/** Builds one coordinator packet; every integer goes out little endian. */
+struct CoordWriter {
+	byte buf[COORD_SEND_BUF];
+	uint len;
+	bool overflow;
+
+	void Init(byte type)
+	{
+		this->len = 3;
+		this->overflow = false;
+		this->buf[2] = type;
+	}
+
+	void U8(byte v)
+	{
+		if (this->len >= COORD_SEND_BUF) {
+			this->overflow = true;
+			return;
+		}
+		this->buf[this->len++] = v;
+	}
+
+	void U16(uint16 v) { this->U8((byte)(v & 0xFF)); this->U8((byte)((v >> 8) & 0xFF)); }
+	void U32(uint32 v) { this->U16((uint16)(v & 0xFFFF)); this->U16((uint16)((v >> 16) & 0xFFFF)); }
+
+	void Str(const char *s)
+	{
+		if (s != NULL) {
+			while (*s != 0) this->U8((byte)*s++);
+		}
+		this->U8(0);
+	}
+
+	void Raw(const byte *d, uint n)
+	{
+		for (uint i = 0; i < n; i++) this->U8(d[i]);
+	}
+
+	/** Patch in the length prefix; false when the packet overflowed. */
+	bool Finish()
+	{
+		if (this->overflow) return false;
+		this->buf[0] = (byte)(this->len & 0xFF);
+		this->buf[1] = (byte)((this->len >> 8) & 0xFF);
+		return true;
+	}
+};
+
+/* ------------------------------------------------------------------ reading */
+
+/** Cursor over one received payload; reads past the end yield zeroes and set bad. */
+struct CoordReader {
+	const byte *d;
+	uint len;
+	uint pos;
+	bool bad;
+
+	void Init(const byte *data, uint length)
+	{
+		this->d = data;
+		this->len = length;
+		this->pos = 0;
+		this->bad = false;
+	}
+
+	byte U8()
+	{
+		if (this->pos >= this->len) {
+			this->bad = true;
+			return 0;
+		}
+		return this->d[this->pos++];
+	}
+
+	uint16 U16()
+	{
+		uint16 a = this->U8();
+		return (uint16)(a | ((uint16)this->U8() << 8));
+	}
+
+	uint32 U32()
+	{
+		uint32 a = this->U16();
+		return a | ((uint32)this->U16() << 16);
+	}
+
+	void Str(char *out, uint size)
+	{
+		uint i = 0;
+		for (;;) {
+			byte c = this->U8();
+			if (c == 0 || this->bad) break;
+			if (i + 1 < size) out[i++] = (char)c;
+		}
+		if (size > 0) out[i < size ? i : size - 1] = 0;
+	}
+
+	void Raw(byte *out, uint n)
+	{
+		for (uint i = 0; i < n; i++) out[i] = this->U8();
+	}
+};
+
+/* ----------------------------------------------------------- game info v4 */
+
+/**
+ * Serialize our game state in NetworkGameInfo wire version 4.
+ * The coordinator accepts versions 1..7 and synthesises the fields that only
+ * exist in newer versions, so there is no reason to implement version 7 here.
+ */
+static void CoordWriteGameInfo(CoordWriter *w)
+{
+	NetworkGameInfo ngi;
+	NetworkFillCurrentGameInfo(&ngi);
+
+	w->U8(4);
+
+	uint count = 0;
+	const GRFConfig *c;
+	for (c = ngi.grfconfig; c != NULL; c = c->next) {
+		if (!HasBit(c->flags, GCF_STATIC)) count++;
+	}
+	if (count > NETWORK_MAX_GRF_COUNT) count = NETWORK_MAX_GRF_COUNT;
+	w->U8((byte)count);
+
+	uint written = 0;
+	for (c = ngi.grfconfig; c != NULL && written < count; c = c->next) {
+		if (HasBit(c->flags, GCF_STATIC)) continue;
+		w->U32(c->grfid);
+		w->Raw(c->md5sum, 16);
+		written++;
+	}
+
+	w->U32(ngi.game_date);
+	w->U32(ngi.start_date);
+	w->U8(ngi.companies_max);
+	w->U8(ngi.companies_on);
+	w->U8(ngi.spectators_max);
+	w->Str(ngi.server_name);
+	w->Str(ngi.server_revision);
+	w->U8(ngi.server_lang);
+	w->U8(ngi.use_password ? 1 : 0);
+	w->U8(ngi.clients_max);
+	w->U8(ngi.clients_on);
+	w->U8(ngi.spectators_on);
+	w->Str(ngi.map_name);
+	w->U16(ngi.map_width);
+	w->U16(ngi.map_height);
+	w->U8(ngi.map_set);
+	w->U8(ngi.dedicated ? 1 : 0);
+}
+
+/** Resolve one NewGRF the listing told us about, exactly as the UDP client does. */
+static void CoordResolveGRF(GRFConfig *config)
+{
+	const GRFConfig *f = FindGRFConfig(config->grfid, config->md5sum);
+	if (f == NULL) {
+		config->name   = FindUnknownGRFName(config->grfid, config->md5sum, true);
+		config->status = GCS_NOT_FOUND;
+	} else {
+		config->filename = f->filename;
+		config->name     = f->name;
+		config->info     = f->info;
+	}
+	SetBit(config->flags, GCF_COPY);
+}
+
+/**
+ * Deserialize a NetworkGameInfo the coordinator sent us. We always request wire
+ * version 4, which is what this build speaks natively, so only that shape is handled.
+ */
+static void CoordReadGameInfo(CoordReader *r, NetworkGameInfo *info)
+{
+	static const Date MAX_DATE = ConvertYMDToDate(MAX_YEAR, 11, 31);
+
+	info->game_info_version = r->U8();
+	if (info->game_info_version != 4) {
+		DEBUG(net, 0, "[coordinator] unexpected game info version %d", info->game_info_version);
+		r->bad = true;
+		return;
+	}
+
+	GRFConfig **dst = &info->grfconfig;
+	uint num_grfs = r->U8();
+	if (num_grfs > NETWORK_MAX_GRF_COUNT) {
+		r->bad = true;
+		return;
+	}
+	for (uint i = 0; i < num_grfs; i++) {
+		GRFConfig *c = CallocT<GRFConfig>(1);
+		c->grfid = r->U32();
+		r->Raw(c->md5sum, 16);
+		CoordResolveGRF(c);
+		*dst = c;
+		dst = &c->next;
+	}
+
+	info->game_date      = Clamp((Date)r->U32(), 0, MAX_DATE);
+	info->start_date     = Clamp((Date)r->U32(), 0, MAX_DATE);
+	info->companies_max  = r->U8();
+	info->companies_on   = r->U8();
+	info->spectators_max = r->U8();
+	r->Str(info->server_name, sizeof(info->server_name));
+	r->Str(info->server_revision, sizeof(info->server_revision));
+	info->server_lang    = r->U8();
+	info->use_password   = (r->U8() != 0);
+	info->clients_max    = r->U8();
+	info->clients_on     = r->U8();
+	info->spectators_on  = r->U8();
+	r->Str(info->map_name, sizeof(info->map_name));
+	info->map_width      = r->U16();
+	info->map_height     = r->U16();
+	info->map_set        = r->U8();
+	info->dedicated      = (r->U8() != 0);
+
+	if (info->server_lang >= NETWORK_NUM_LANGUAGES) info->server_lang = 0;
+	if (info->map_set >= NETWORK_NUM_LANDSCAPES) info->map_set = 0;
+}
+
+/* ----------------------------------------------------------------- plumbing */
+
+static void CoordQueue(CoordWriter *w)
+{
+	if (!w->Finish()) {
+		DEBUG(net, 0, "[coordinator] outgoing packet too large, dropped");
+		return;
+	}
+	if (_coord_slen + w->len > COORD_SEND_BUF) {
+		DEBUG(net, 0, "[coordinator] send buffer full, packet dropped");
+		return;
+	}
+	memcpy(_coord_sbuf + _coord_slen, w->buf, w->len);
+	_coord_slen += w->len;
+}
+
+static void CoordCloseSocket()
+{
+	if (_coord_sock != INVALID_SOCKET) {
+		closesocket(_coord_sock);
+		_coord_sock = INVALID_SOCKET;
+	}
+	_coord_rlen = 0;
+	_coord_slen = 0;
+	_coord_spos = 0;
+	_coord_registered = false;
+	_coord_register_sent = false;
+	_coord_listing = false;
+}
+
+/** Connecter that hands the finished socket to this module. */
+class NetworkCoordinatorConnecter : public TCPConnecter {
+public:
+	NetworkCoordinatorConnecter(const NetworkAddress &address) : TCPConnecter(address) {}
+
+	virtual void OnFailure()
+	{
+		_coord_connecting = false;
+		DEBUG(net, 0, "[coordinator] could not connect");
+		_coord_retry_at = _realtime_tick + _coord_retry_delay;
+		if (_coord_retry_delay < COORD_RECONNECT_MAX) _coord_retry_delay *= 2;
+	}
+
+	virtual void OnConnect(SOCKET s)
+	{
+		_coord_connecting = false;
+		_coord_sock = s;
+		SetNonBlocking(s);
+		_coord_retry_delay = COORD_RECONNECT_MIN;
+		DEBUG(net, 1, "[coordinator] connected");
+	}
+};
+
+static void CoordEnsureConnected()
+{
+	if (_coord_sock != INVALID_SOCKET || _coord_connecting) return;
+	if (_realtime_tick < _coord_retry_at) return;
+
+	if (_coord_rbuf == NULL) _coord_rbuf = MallocT<byte>(COORD_RECV_BUF);
+	if (_coord_sbuf == NULL) _coord_sbuf = MallocT<byte>(COORD_SEND_BUF);
+
+	_coord_connecting = true;
+	DEBUG(net, 1, "[coordinator] connecting to %s:%d", NETWORK_COORDINATOR_SERVER_HOST, NETWORK_COORDINATOR_SERVER_PORT);
+	new NetworkCoordinatorConnecter(NetworkAddress(NETWORK_COORDINATOR_SERVER_HOST, NETWORK_COORDINATOR_SERVER_PORT));
+}
+
+/* ------------------------------------------------------------ sending state */
+
+static void CoordSendRegister()
+{
+	CoordWriter w;
+	w.Init(PACKET_COORDINATOR_SERVER_REGISTER);
+	w.U8(NETWORK_COORDINATOR_VERSION);
+	w.U8(SERVER_GAME_TYPE_PUBLIC);
+	w.U16(_settings_client.network.server_port);
+	/* Empty strings on a first registration; the coordinator then issues a code. */
+	w.Str(_coord_invite_code);
+	w.Str(_coord_invite_secret);
+	CoordQueue(&w);
+
+	_coord_register_sent = true;
+	DEBUG(net, 1, "[coordinator] registering server on port %d", _settings_client.network.server_port);
+}
+
+static void CoordSendUpdate()
+{
+	CoordWriter w;
+	w.Init(PACKET_COORDINATOR_SERVER_UPDATE);
+	w.U8(NETWORK_COORDINATOR_VERSION);
+	CoordWriteGameInfo(&w);
+	CoordQueue(&w);
+
+	_coord_next_update = _realtime_tick + COORD_UPDATE_INTERVAL;
+}
+
+static void CoordSendListing()
+{
+	CoordWriter w;
+	w.Init(PACKET_COORDINATOR_CLIENT_LISTING);
+	w.U8(NETWORK_COORDINATOR_VERSION);
+	w.U8(4); // the NetworkGameInfo version we want back
+	w.Str(_openttd_revision);
+	/* No newgrf_lookup_cursor: that field only exists from version 4 up, and
+	 * sending it at version 2 makes the coordinator drop the connection. */
+	CoordQueue(&w);
+
+	_coord_listing = true;
+	_coord_listing_wanted = false;
+	_coord_listed_count = 0;
+	DEBUG(net, 1, "[coordinator] requested server listing");
+}
+
+static void CoordSendConnect(const char *invite_code)
+{
+	CoordWriter w;
+	w.Init(PACKET_COORDINATOR_CLIENT_CONNECT);
+	w.U8(NETWORK_COORDINATOR_VERSION);
+	w.Str(invite_code);
+	CoordQueue(&w);
+
+	DEBUG(net, 1, "[coordinator] resolving invite code %s", invite_code);
+}
+
+/* ---------------------------------------------------------- packet handlers */
+
+static void CoordHandleError(CoordReader *r)
+{
+	byte code = r->U8();
+	char detail[128];
+	r->Str(detail, sizeof(detail));
+
+	DEBUG(net, 0, "[coordinator] error %d: %s", code, detail);
+
+	if (code == NETWORK_COORDINATOR_ERROR_REGISTRATION_FAILED ||
+			code == NETWORK_COORDINATOR_ERROR_REUSE_OF_INVITE_CODE) {
+		/* Drop the stored code so the next attempt asks for a fresh one. */
+		_coord_invite_code[0] = 0;
+		_coord_invite_secret[0] = 0;
+	}
+	CoordCloseSocket();
+}
+
+static void CoordHandleRegisterAck(CoordReader *r)
+{
+	/* At protocol version >= 2 the ack carries the invite code and its secret. */
+	r->Str(_coord_invite_code, sizeof(_coord_invite_code));
+	r->Str(_coord_invite_secret, sizeof(_coord_invite_secret));
+	_coord_conn_type = r->U8();
+
+	if (r->bad) {
+		DEBUG(net, 0, "[coordinator] malformed register ack");
+		CoordCloseSocket();
+		return;
+	}
+
+	_coord_registered = true;
+
+	switch (_coord_conn_type) {
+		case CONNECTION_TYPE_DIRECT:
+			DEBUG(net, 0, "[coordinator] server registered and directly reachable, invite code %s", _coord_invite_code);
+			break;
+
+		case CONNECTION_TYPE_ISOLATED:
+			DEBUG(net, 0, "[coordinator] server registered but NOT reachable from the internet");
+			DEBUG(net, 0, "[coordinator]   forward TCP port %d to this machine, otherwise nobody can join", _settings_client.network.server_port);
+			break;
+
+		default:
+			/* STUN/TURN would be needed; we do not implement either. */
+			DEBUG(net, 0, "[coordinator] server registered with connection type %d (needs NAT traversal we do not support)", _coord_conn_type);
+			break;
+	}
+
+	/* Only a server with game info attached is put on the list. */
+	CoordSendUpdate();
+}
+
+static void CoordHandleListing(CoordReader *r)
+{
+	uint16 count = r->U16();
+
+	if (count == 0) {
+		/* End-of-list marker. */
+		_coord_listing = false;
+		DEBUG(net, 0, "[coordinator] server listing complete, %d servers", _coord_listed_count);
+		UpdateNetworkGameWindow(false);
+		return;
+	}
+
+	for (uint16 i = 0; i < count && !r->bad; i++) {
+		char connection_string[NETWORK_INVITE_CODE_LENGTH];
+		r->Str(connection_string, sizeof(connection_string));
+
+		NetworkGameList *item;
+		if (connection_string[0] == '+') {
+			/* Invite-code server: it has no address at all until the coordinator
+			 * resolves it, and unresolved addresses all compare equal, so this
+			 * MUST be keyed by the code rather than by NetworkAddress. */
+			item = NetworkGameListAddItemByInviteCode(connection_string);
+		} else {
+			/* "host:port"; split on the last colon so IPv4 literals work. */
+			char host[NETWORK_HOSTNAME_LENGTH];
+			strecpy(host, connection_string, lastof(host));
+			uint16 port = NETWORK_DEFAULT_PORT;
+			char *colon = strrchr(host, ':');
+			if (colon != NULL) {
+				*colon = 0;
+				port = (uint16)atoi(colon + 1);
+			}
+			item = NetworkGameListAddItem(NetworkAddress(host, port));
+			item->invite_code[0] = 0;
+		}
+
+		if (item == NULL) continue;
+
+		ClearGRFConfigList(&item->info.grfconfig);
+		CoordReadGameInfo(r, &item->info);
+
+		/* Decide whether we could actually join. The UDP reply path does exactly
+		 * this in network_udp.cpp:253-297, and it has to be repeated here: the
+		 * flags start out zeroed, and a zeroed version_compatible makes every
+		 * server show up as VERSION MISMATCH with the Join button greyed out -
+		 * even our own, whose revision is character-for-character identical. */
+		item->info.compatible = true;
+		for (const GRFConfig *c = item->info.grfconfig; c != NULL; c = c->next) {
+			if (c->status == GCS_NOT_FOUND) item->info.compatible = false;
+		}
+		item->info.version_compatible = IsNetworkCompatibleVersion(item->info.server_revision);
+		item->info.compatible &= item->info.version_compatible;
+
+		item->online = true;
+		item->from_coordinator = true;
+		item->retries = 0;
+		_coord_listed_count++;
+	}
+
+	if (r->bad) DEBUG(net, 0, "[coordinator] truncated listing packet");
+
+	/* The coordinator sends one server per packet, so refreshing the window on
+	 * every packet would repaint the list ~245 times - far too slow on a 68k.
+	 * Show progress occasionally and do a final redraw on the end marker. */
+	if ((_coord_listed_count % 25) == 0) UpdateNetworkGameWindow(false);
+}
+
+static void CoordHandleDirectConnect(CoordReader *r)
+{
+	char token[NETWORK_COORDINATOR_TOKEN_LENGTH];
+	r->Str(token, sizeof(token));
+	r->U8(); // tracking number, only needed to report a failure back
+	char host[NETWORK_HOSTNAME_LENGTH];
+	r->Str(host, sizeof(host));
+	uint16 port = r->U16();
+
+	if (r->bad) {
+		DEBUG(net, 0, "[coordinator] malformed direct-connect packet");
+		return;
+	}
+
+	DEBUG(net, 1, "[coordinator] invite code resolved to %s:%d", host, port);
+
+	/* Tell the coordinator we took it from here; only clients send this. */
+	CoordWriter w;
+	w.Init(PACKET_COORDINATOR_CLIENT_CONNECTED);
+	w.U8(NETWORK_COORDINATOR_VERSION);
+	w.Str(token);
+	CoordQueue(&w);
+
+	/* Point the list entry at the real address and open the lobby for it. */
+	for (NetworkGameList *item = _network_game_list; item != NULL; item = item->next) {
+		if (strcmp(item->invite_code, _coord_join_invite) != 0) continue;
+
+		item->address = NetworkAddress(host, port);
+		snprintf(_settings_client.network.last_host, sizeof(_settings_client.network.last_host), "%s", host);
+		_settings_client.network.last_port = port;
+		_coord_join_invite[0] = 0;
+		ShowNetworkLobbyWindow(item);
+		return;
+	}
+
+	/* The entry vanished (list refreshed); join straight away instead. */
+	_coord_join_invite[0] = 0;
+	NetworkClientConnectGame(NetworkAddress(host, port), COMPANY_SPECTATOR);
+}
+
+static void CoordHandleConnectFailed(CoordReader *r)
+{
+	char token[NETWORK_COORDINATOR_TOKEN_LENGTH];
+	r->Str(token, sizeof(token));
+
+	DEBUG(net, 0, "[coordinator] could not connect to that server");
+	DEBUG(net, 0, "[coordinator]   it is probably behind a NAT and would need STUN/TURN, which this build does not implement");
+	_coord_join_invite[0] = 0;
+}
+
+/** Dispatch one complete packet. Unknown types are skipped, never fatal. */
+static void CoordHandlePacket(byte type, const byte *payload, uint length)
+{
+	CoordReader r;
+	r.Init(payload, length);
+
+	switch (type) {
+		case PACKET_COORDINATOR_GC_ERROR:          CoordHandleError(&r); break;
+		case PACKET_COORDINATOR_GC_REGISTER_ACK:   CoordHandleRegisterAck(&r); break;
+		case PACKET_COORDINATOR_GC_LISTING:        CoordHandleListing(&r); break;
+		case PACKET_COORDINATOR_GC_DIRECT_CONNECT: CoordHandleDirectConnect(&r); break;
+		case PACKET_COORDINATOR_GC_CONNECT_FAILED: CoordHandleConnectFailed(&r); break;
+
+		case PACKET_COORDINATOR_GC_CONNECTING:
+			/* Just an acknowledgement that our connect request is being worked on. */
+			break;
+
+		case PACKET_COORDINATOR_GC_STUN_REQUEST:
+		case PACKET_COORDINATOR_GC_STUN_CONNECT:
+		case PACKET_COORDINATOR_GC_TURN_CONNECT:
+			/* We do not implement NAT traversal. A port-forwarded server is reached
+			 * by the direct path, which the coordinator always tries first, so these
+			 * can be ignored safely - but they DO arrive unsolicited, hence this case. */
+			DEBUG(net, 2, "[coordinator] ignoring NAT traversal packet %d", type);
+			break;
+
+		default:
+			DEBUG(net, 2, "[coordinator] ignoring unknown packet type %d", type);
+			break;
+	}
+}
+
+/* ----------------------------------------------------------------- game loop */
+
+static void CoordFlushSend()
+{
+	while (_coord_spos < _coord_slen) {
+		ssize_t res = send(_coord_sock, (const char *)_coord_sbuf + _coord_spos, _coord_slen - _coord_spos, 0);
+		if (res == -1) {
+			int err = GET_LAST_ERROR();
+			if (err == EWOULDBLOCK) return;
+			DEBUG(net, 0, "[coordinator] send failed with error %d", err);
+			CoordCloseSocket();
+			return;
+		}
+		if (res == 0) {
+			CoordCloseSocket();
+			return;
+		}
+		_coord_spos += res;
+	}
+
+	/* Everything went out; reset the buffer. */
+	_coord_spos = 0;
+	_coord_slen = 0;
+}
+
+/**
+ * Consume every complete packet sitting in the receive buffer and compact it.
+ * Must be interleaved with recv(): the full listing is ~57 KB while the buffer
+ * is 32 KB, so draining the socket first and parsing afterwards would overrun
+ * and lose the tail (that bug capped the server list at the first few entries).
+ */
+static void CoordParseBuffer()
+{
+	for (;;) {
+		if (_coord_rlen < 3) return;
+
+		uint length = (uint)_coord_rbuf[0] | ((uint)_coord_rbuf[1] << 8);
+		if (length < 3 || length > COORD_RECV_BUF) {
+			DEBUG(net, 0, "[coordinator] bogus packet length %d, dropping connection", length);
+			CoordCloseSocket();
+			return;
+		}
+		if (_coord_rlen < length) return; /* wait for the rest */
+
+		byte type = _coord_rbuf[2];
+		CoordHandlePacket(type, _coord_rbuf + 3, length - 3);
+
+		/* A handler may have closed the socket (GC_ERROR, malformed data). */
+		if (_coord_sock == INVALID_SOCKET) return;
+
+		_coord_rlen -= length;
+		if (_coord_rlen > 0) memmove(_coord_rbuf, _coord_rbuf + length, _coord_rlen);
+	}
+}
+
+static void CoordReceive()
+{
+	for (;;) {
+		/* Free up room before asking for more. */
+		CoordParseBuffer();
+		if (_coord_sock == INVALID_SOCKET) return;
+
+		if (_coord_rlen >= COORD_RECV_BUF) {
+			/* Cannot happen: the coordinator caps a packet at 32767 bytes, so a
+			 * full buffer always contains at least one complete packet that the
+			 * parse above would have consumed. */
+			DEBUG(net, 0, "[coordinator] receive buffer full with no complete packet, dropping connection");
+			CoordCloseSocket();
+			return;
+		}
+
+		ssize_t res = recv(_coord_sock, (char *)_coord_rbuf + _coord_rlen, COORD_RECV_BUF - _coord_rlen, 0);
+		if (res == -1) {
+			int err = GET_LAST_ERROR();
+			if (err != EWOULDBLOCK) {
+				DEBUG(net, 0, "[coordinator] recv failed with error %d", err);
+				CoordCloseSocket();
+				return;
+			}
+			break; /* nothing more for now */
+		}
+		if (res == 0) {
+			DEBUG(net, 1, "[coordinator] connection closed by peer");
+			CoordCloseSocket();
+			return;
+		}
+		_coord_rlen += res;
+	}
+
+	CoordParseBuffer();
+}
+
+void NetworkCoordinatorGameLoop()
+{
+	if (!_network_available) return;
+
+	bool want_server = (_networking && _network_server && _settings_client.network.server_advertise);
+	bool want_client = (_coord_listing_wanted || _coord_listing || _coord_join_invite[0] != 0);
+
+	if (want_server) {
+		_coord_role = COORD_ROLE_SERVER;
+	} else if (want_client) {
+		_coord_role = COORD_ROLE_CLIENT;
+	} else {
+		/* Nothing to do; drop an idle connection. */
+		if (_coord_sock != INVALID_SOCKET && _coord_role == COORD_ROLE_SERVER) CoordCloseSocket();
+		_coord_role = COORD_ROLE_NONE;
+		return;
+	}
+
+	CoordEnsureConnected();
+	if (_coord_sock == INVALID_SOCKET) return;
+
+	if (_coord_role == COORD_ROLE_SERVER) {
+		if (!_coord_register_sent) {
+			CoordSendRegister();
+		} else if (_coord_registered && _realtime_tick >= _coord_next_update) {
+			CoordSendUpdate();
+		}
+	} else {
+		if (_coord_listing_wanted) CoordSendListing();
+		if (_coord_join_invite[0] != 0 && !_coord_listing) {
+			static char last_sent[NETWORK_INVITE_CODE_LENGTH];
+			if (strcmp(last_sent, _coord_join_invite) != 0) {
+				strecpy(last_sent, _coord_join_invite, lastof(last_sent));
+				CoordSendConnect(_coord_join_invite);
+			}
+		}
+	}
+
+	CoordFlushSend();
+	if (_coord_sock == INVALID_SOCKET) return;
+	CoordReceive();
+}
+
+/* --------------------------------------------------------------- public API */
+
+void NetworkCoordinatorRequestListing()
+{
+	if (!_network_available) return;
+
+	_coord_listing_wanted = true;
+	/* A fresh listing should not inherit the previous connection's state. */
+	if (_coord_role == COORD_ROLE_SERVER) CoordCloseSocket();
+	_coord_retry_at = 0;
+}
+
+bool NetworkCoordinatorIsListing()
+{
+	return _coord_listing || _coord_listing_wanted;
+}
+
+void NetworkCoordinatorJoinInviteCode(const char *invite_code)
+{
+	if (!_network_available || invite_code == NULL || invite_code[0] == 0) return;
+
+	strecpy(_coord_join_invite, invite_code, lastof(_coord_join_invite));
+	_coord_retry_at = 0;
+}
+
+void NetworkCoordinatorRegisterServer()
+{
+	_coord_register_sent = false;
+	_coord_registered = false;
+	_coord_retry_at = 0;
+}
+
+void NetworkCoordinatorUnregisterServer()
+{
+	if (_coord_role != COORD_ROLE_SERVER) return;
+	CoordCloseSocket();
+	_coord_role = COORD_ROLE_NONE;
+}
+
+void NetworkCoordinatorShutdown()
+{
+	CoordCloseSocket();
+	free(_coord_rbuf);
+	free(_coord_sbuf);
+	_coord_rbuf = NULL;
+	_coord_sbuf = NULL;
+	_coord_role = COORD_ROLE_NONE;
+	_coord_listing_wanted = false;
+	_coord_join_invite[0] = 0;
+}
+
+#endif /* ENABLE_NETWORK */
