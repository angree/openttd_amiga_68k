+/**
+ * Cut the parenthetical note off a vehicle name from a NewGRF.
+ *
+ * Modern sets append an explanation to the name - "Konstal 105N (high
+ * capacity, up to 3 units)", "Tram Sanok SN2 (with optional PN2 trailer)".
+ * On a 320- or 544-pixel wide purchase list that neither fits nor reads, and
+ * it does not match the house style of the built-in names, which are bare.
+ * Everything from the first " (" is dropped; a name without one is untouched.
+ */
+static const char *ShortenVehicleName(const char *name, char *buf, size_t len)
+{
+	const char *paren = strstr(name, " (");
+	if (paren == NULL) return name;
+
+	size_t n = (size_t)(paren - name);
+	if (n >= len) n = len - 1;
+	memcpy(buf, name, n);
+	buf[n] = '␀';
+	return buf;
+}
