+/**
+ * Answer the game coordinator's reachability probe.
+ *
+ * To decide whether a registering server is directly reachable, the coordinator
+ * opens a plain TCP connection to our game port and sends an empty game-info
+ * request, expecting the serialized NetworkGameInfo back. Modern OpenTTD calls
+ * these PACKET_CLIENT_GAME_INFO (7) and PACKET_SERVER_GAME_INFO (6); 1.0.5 has
+ * neither, and in its numbering those two slots hold PACKET_SERVER_* packets
+ * that only ever travel server->client, so receiving one here is otherwise a
+ * protocol error. Reusing slot 7 for the request and slot 6 for the reply is
+ * therefore wire-compatible with the coordinator and costs us nothing.
+ *
+ * Without this the probe times out, the coordinator marks us ConnectionType
+ * Isolated and we are never listed. The reply must carry no trailing bytes.
+ */
+static NetworkRecvStatus ReceiveGameInfoProbe(NetworkClientSocket *cs, Packet *p)
+{
+	NetworkGameInfo ngi;
+	NetworkFillCurrentGameInfo(&ngi);
+
+	Packet *reply = new Packet(PACKET_SERVER_CLIENT_INFO);
+	cs->Send_NetworkGameInfo(reply, &ngi);
+	cs->Send_Packet(reply);
+
+	DEBUG(net, 2, "[server] answered game-info probe");
+
+	/* Leave the connection open: the peer closes it once it has the reply. */
+	return NETWORK_RECV_STATUS_OKAY;
+}
