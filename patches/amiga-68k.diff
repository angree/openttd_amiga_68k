+	lsr.l	#1,d7
+	add.l	C2P1X1_6_C5_BM_040_DELTA5(sp),a1
+	eor.l	d4,d6
+	eor.l	d5,d7
+	and.l	#$55555555,d6
+	and.l	#$55555555,d7
+	eor.l	d6,d4
+	eor.l	d7,d5
+	move.l	d4,(a1)
