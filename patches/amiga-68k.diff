+/**
+ * Find or create the list entry for a coordinator server known only by its
+ * invite code.
+ *
+ * NetworkGameListAddItem() keys entries on NetworkAddress, whose operator==
+ * compares the raw sockaddr (address.h:189). An invite code such as "+7RCyAUV"
+ * never resolves, so every such entry has a zeroed, zero-length address and they
+ * all compare EQUAL to one another - the whole public list would collapse into a
+ * single row that keeps getting overwritten. Key these by the code instead.
+ * @param invite_code the coordinator invite code
+ * @return the (new or existing) list entry
+ */
+NetworkGameList *NetworkGameListAddItemByInviteCode(const char *invite_code)
+{
+	if (StrEmpty(invite_code)) return NULL;
+
+	NetworkGameList *item, *prev_item = NULL;
+	for (item = _network_game_list; item != NULL; item = item->next) {
+		if (strcmp(item->invite_code, invite_code) == 0) return item;
+		prev_item = item;
+	}
+
+	item = CallocT<NetworkGameList>(1);
+	item->next = NULL;
+	strecpy(item->invite_code, invite_code, lastof(item->invite_code));
+
+	if (prev_item == NULL) {
+		_network_game_list = item;
+	} else {
+		prev_item->next = item;
+	}
+
+	/* Deliberately no UpdateNetworkGameWindow() here: the coordinator adds a
+	 * few hundred of these in one go and repainting each time is far too slow
+	 * on a 68k. The caller refreshes periodically instead. */
+	return item;
+}
