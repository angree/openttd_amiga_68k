+	lsr.l	#1,d6
+
+	cmp.l	a0,a2				; End of line passed?
+	bhs.s	.xstart
+
+	add.w	C2P1X1_6_C5_BM_040_CHUNKYX(sp),a2 ; Skip to end of next
+						  ; line
+	add.l	C2P1X1_6_C5_BM_040_ROWMOD(sp),a1  ; Skip to beginning of
+						  ; next line
+.xstart
+	eor.l	d0,d6
+	and.l	#$55555555,d6
+	eor.l	d6,d0
+	add.l	d6,d6
+	eor.l	d6,d1
+
+	move.l	d0,(a1)
+
+	move.l	d5,d6			; Swap/Merge 2x4, part 2
+	move.l	d3,d7
+	lsr.l	#2,d6
+	lsr.l	#2,d7
+	eor.l	d4,d6
+	eor.l	d2,d7
+	and.l	#$33333333,d6
+	and.l	#$33333333,d7
+	eor.l	d6,d4
+	eor.l	d7,d2
+	lsl.l	#2,d6
+	lsl.l	#2,d7
+	eor.l	d6,d5
