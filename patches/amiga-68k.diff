+ * built from gethostbyname/inet_addr/inet_ntoa, which every Amiga stack has. */
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+int ottd_amiga_getaddrinfo(const char *node, const char *service, const struct addrinfo *hints, struct addrinfo **res)
+{
+	*res = NULL;
+	int want_family = (hints != NULL) ? hints->ai_family : AF_UNSPEC;
+	if (want_family == AF_INET6) return 1;   /* IPv4-only: no results for AF_INET6 */
+
+	struct sockaddr_in *sin = (struct sockaddr_in *)calloc(1, sizeof(*sin));
+	struct addrinfo    *ai  = (struct addrinfo *)calloc(1, sizeof(*ai));
+	if (sin == NULL || ai == NULL) { free(sin); free(ai); return 1; }
+
+	unsigned short port = 0;
+	if (service != NULL && *service != '\0') port = (unsigned short)atoi(service);
+
+	sin->sin_len    = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_port   = htons(port);
+
+	if (node == NULL || *node == '\0') {
+		sin->sin_addr.s_addr = INADDR_ANY;                 /* passive / wildcard bind */
+	} else {
+		unsigned long a = inet_addr(node);
+		if (a != INADDR_NONE) {
+			sin->sin_addr.s_addr = a;                      /* numeric dotted quad */
+		} else {
+			struct hostent *he = gethostbyname(node);      /* name lookup */
+			if (he == NULL || he->h_addr_list == NULL || he->h_addr_list[0] == NULL) {
+				free(sin); free(ai); return 1;
+			}
+			memcpy(&sin->sin_addr, he->h_addr_list[0], sizeof(sin->sin_addr));
+		}
+	}
+
+	ai->ai_family   = AF_INET;
+	ai->ai_socktype = (hints != NULL) ? hints->ai_socktype : 0;
+	ai->ai_protocol = 0;
+	ai->ai_addrlen  = sizeof(*sin);
+	ai->ai_addr     = (struct sockaddr *)sin;
+	ai->ai_next     = NULL;
+	*res = ai;
+	return 0;
+}
+
+void ottd_amiga_freeaddrinfo(struct addrinfo *res)
+{
+	while (res != NULL) {
+		struct addrinfo *next = res->ai_next;
+		free(res->ai_addr);
+		free(res);
+		res = next;
+	}
+}
+
+int ottd_amiga_getnameinfo(const struct sockaddr *sa, socklen_t salen, char *host, size_t hostlen, char *serv, size_t servlen, int flags)
+{
+	(void)salen; (void)flags;
+	const struct sockaddr_in *sin = (const struct sockaddr_in *)sa;
+	if (host != NULL && hostlen > 0) {
+		/* Format the dotted quad from the raw bytes rather than inet_ntoa()
+		 * (bsdsocket only exports Inet_NtoA; the lowercase BSD wrapper does not
+		 * link). s_addr is in network byte order and 68k is big-endian, so the
+		 * four octets are already in a.b.c.d order. */
+		const unsigned char *ip = (const unsigned char *)&sin->sin_addr;
+		snprintf(host, hostlen, "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]);
+		host[hostlen - 1] = '\0';
+	}
+	if (serv != NULL && servlen > 0) {
+		snprintf(serv, servlen, "%u", (unsigned)ntohs(sin->sin_port));
+	}
+	return 0;
+}
