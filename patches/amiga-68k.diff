+
+/* Used during safety scan on unsafe actions */
+static void GRFUnsafe(ByteReader *buf)
+{
+	SetBit(_cur_grfconfig->flags, GCF_UNSAFE);
+
+	/* Skip remainder of GRF */
+	_skip_sprites = -1;
+}
