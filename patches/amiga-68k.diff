+void SQVM::Finalize()
+{
+	_roottable = _null_;
+	_lasterror = _null_;
+	_errorhandler = _null_;
+	_debughook = _null_;
+	temp_reg = _null_;
+	_callstackdata.resize(0);
+	SQInteger size=_stack.size();
+	for(SQInteger i=size - 1;i>=0;i--)
+		_stack[i]=_null_;
+}
